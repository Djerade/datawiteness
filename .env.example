# --- Base de données ---
POSTGRES_USER=datawitness
POSTGRES_PASSWORD=datawitness
POSTGRES_DB=datawitness
DATABASE_URL=postgresql+psycopg://datawitness:datawitness@localhost:5432/datawitness

# --- API ---
API_ENV=dev
API_CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=../data/raw

# --- IA ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- Seuils de détection ---
MATCH_SIMILARITY_THRESHOLD=0.78
DIVERGENCE_RELATIVE_TOLERANCE=0.02

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api/v1
